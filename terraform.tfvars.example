# Configuration example - Copy this file to terraform.tfvars and customize

# REQUIRED: Your GCP project
project_id = "your-gcp-project-id"

# Region and zone (default: Belgium)
# region = "europe-west1"
# zone   = "europe-west1-b"
# Madrid: region = "europe-southwest1", zone = "europe-southwest1-a"

# Machine type (default: e2-standard-2 = 2 vCPU, 8GB RAM)
# machine_type = "e2-standard-2"

# Number of nodes to deploy (default: 1)
# node_count = 1

# Secure SSH via IAP (default: true)
# enable_iap_ssh = true

# Allowed CIDRs for SSH when enable_iap_ssh=false
# allowed_ssh_cidrs = ["0.0.0.0/0"]
